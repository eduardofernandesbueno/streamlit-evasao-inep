# # modelos/
# dados/bruto/
# dados/intermediario/
# resultados/
# relatorios/
# documentos/graficos/
# notebooks/
# acessibilidade_web/graficos/

# # Não versionar microdados, CSVs e textos derivados
# # *.csv
# # *.txt
# dados/bruto/*.csv
# dados/bruto/*.zip
# dados/intermediario/*.csv

# # PDFs grandes, relatórios finais, TCC etc.
# # *.pdf

# # Logs e arquivos temporários
# *.log
# log_erros.txt
# *.tmp
# *.zip
# *.tar.gz

# # ============================
# # Modelos e artefatos treinados
# # ============================
# # *.pkl
# *.h5

# # ============================
# # Ambientes virtuais e configs de ambiente
# # ============================
# .venv/
# env/
# ambiente/.venv/
# ambiente/ambiente.yml
# # ambiente/requirements.txt
# .env

# # ============================
# # Notebooks e checkpoints
# # ============================
# .ipynb_checkpoints/

# # ============================
# # Arquivos do sistema operacional
# # ============================
# .DS_Store
# .Trash/
# Thumbs.db

# # ============================
# # Arquivos temporários e de backup
# # ============================
# *~
# *.swp
# *.swo

# # ============================
# # Caches e compilados Python
# # ============================
# __pycache__/
# *.py[cod]
# *$py.class

# # ============================
# # Configurações de IDEs/editores
# # ============================
# .vscode/
# *.sublime-project
# *.sublime-workspace
# .Rproj.user
# *.Rproj
# # ============================
# # CSVs de dados_processado não usados pelo app Streamlit
# # ============================

# # Ignora todos os CSVs processados...
# dados/processado/dados_cursos_*.csv
# dados/processado/dados_ies_*.csv
# dados/processado/dados_cursos_tratado_*.csv
# dados/processado/dados_ies_tratado_*.csv

# # ...EXCETO os que o app_evasao.py realmente consome em produção
# !dados/processado/dados_ingresso_evasao_conclusao.csv
# !dados/processado/final_administracao.csv
# !dados/processado/final_direito.csv
# !dados/processado/final_eng_civil.csv
# !dados/processado/final_medicina.csv
# !dados/processado/final_ingressantes.csv
# !dados/processado/dados_cursos_serie_temporal.csv
# modelos/modelos_salvos/
# *.pkl

!requirements.txt

# =========================================================
# DATASETS E PIPELINE DE DADOS
# =========================================================

# Dados brutos e intermediários (regeráveis pelo pipeline)
dados/bruto/
dados/intermediario/
dados/tmp/
dados/cache/

# Dados processados grandes
dados/processado/*.csv
dados/processado/*.parquet
dados/processado/*.feather

# Permitir apenas datasets usados diretamente no app Streamlit
!dados/processado/final_administracao.csv
!dados/processado/final_direito.csv
!dados/processado/final_eng_civil.csv
!dados/processado/final_medicina.csv
